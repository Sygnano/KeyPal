{
  "name": "kboard-companion",
  "license": "GPL-3.0-or-later",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build": "tauri build",
    "build:ui": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome lint --error-on-warnings",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json",
    "e2e": "esbuild \"e2e/*.e2e.ts\" --bundle --platform=node --format=esm --packages=external --log-level=warning --outdir=.cache/e2e && node --test --test-reporter=spec \".cache/e2e/*.e2e.js\"",
    "test": "esbuild scripts/selftest.ts \"tests/*.test.ts\" --bundle --platform=node --format=esm --log-level=warning --outdir=.cache/tests && node .cache/tests/scripts/selftest.js && node --test \".cache/tests/tests/*.test.js\"",
    "tauri": "tauri",
    "bump": "node scripts/bump.mjs"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/barlow": "^5.1.0",
    "@fontsource/barlow-condensed": "^5.1.0",
    "@lezer/highlight": "^1.2.4",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "codemirror": "^6.0.2",
    "react": "^18.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "typescript": "~5.6.3",
    "vite": "^8.3.1"
  }
}
